<script>
$(document).ready(function() {
    var $ads = $(".ads-google-left"),
        $window = $(window),
        $mainPage = $("#main-page"),
        adsOriginalTop = $ads.offset().top,
        adsOriginalWidth = $ads.width(),
        offsetBottom = 10; // Khoảng cách từ đáy của #main-page đến điểm dừng của quảng cáo

    function updateAdsPosition() {
        var scrollTop = $window.scrollTop(),
            mainPageOffsetTop = $mainPage.offset().top,
            mainPageHeight = $mainPage.outerHeight(),
            adsHeight = $ads.outerHeight(),
            stopPoint = mainPageOffsetTop + mainPageHeight - adsHeight - offsetBottom,
            isBeyondStartPoint = scrollTop > adsOriginalTop - offsetBottom,
            windowInnerHeight = window.innerHeight || document.documentElement.clientHeight;

        if (isBeyondStartPoint && scrollTop < stopPoint) {
            $ads.css({
                position: 'fixed',
                top: 0,
                width: adsOriginalWidth
            });
        } else if (scrollTop >= stopPoint) {
            var adsTopPositionRelativeToViewport = mainPageHeight + mainPageOffsetTop - scrollTop - adsHeight - offsetBottom;
            $ads.css({
                position: 'fixed',
                top: adsTopPositionRelativeToViewport,
                width: adsOriginalWidth
            });
        } else {
            $ads.css({
                position: 'static',
                width: 'auto'
            });
        }
    }

    $window.scroll(updateAdsPosition);
    updateAdsPosition(); // Ensure the ad is correctly positioned on page load
});

</script>
